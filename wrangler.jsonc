{
  // FinSight — Cloudflare Workers deployment via @opennextjs/cloudflare
  // Custom worker.ts wraps the OpenNext-generated .open-next/worker.js
  // to inject security headers (CSP, HSTS, X-Frame-Options, etc.) on
  // every response. The wrapper is a thin pass-through; all Next.js
  // behaviour comes from the underlying OpenNext worker.
  "name": "finsight",
  "main": "worker.ts",
  "compatibility_date": "2025-01-01",
  "compatibility_flags": ["nodejs_compat"],

  // Keep the workers.dev URL live alongside the custom domain during the
  // transition: FinSight's OTP sign-in needs the new domain added to the
  // Supabase Auth redirect allowlist first. Flip to false (or remove) once
  // Supabase URL Configuration is updated, for a clean branded-only finish.
  "workers_dev": true,

  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },

  // ─── Public Supabase config ──────────────────────────────────────────────
  // These two are PUBLIC — the anon key is meant to be exposed to browser
  // clients. Row-Level Security policies on the database enforce per-firm
  // scoping, so a leaked anon key cannot bypass tenancy.
  //
  // Derek: REPLACE these placeholders with values from your Supabase
  // project dashboard (Settings → API). Set the SERVICE_ROLE_KEY as a
  // wrangler secret instead — never put it in this file:
  //   echo "<service_role_key>" | wrangler secret put SUPABASE_SERVICE_ROLE_KEY
  "vars": {
    "NEXT_PUBLIC_SUPABASE_URL": "https://camphmqvrzqpgrhdjafo.supabase.co",
    "NEXT_PUBLIC_SUPABASE_ANON_KEY": "sb_publishable_wiFj4325ez0dD6O7ZYN6GA_igE_c9ov"
  },

  // ─── Environments ─────────────────────────────────────────────────────────
  // Add D1/KV/R2 bindings here when you add a backend database (Phase 2+).
  // Example (uncomment when ready):
  // "kv_namespaces": [
  //   { "binding": "CACHE", "id": "YOUR_KV_NAMESPACE_ID" }
  // ],
  // "d1_databases": [
  //   { "binding": "DB", "database_name": "finsight", "database_id": "YOUR_DB_ID" }
  // ],

  "observability": {
    "enabled": true
  },

  // Custom domain: on `wrangler deploy`, provisions the TLS cert + a proxied
  // DNS record in the arktosmarketing.com zone and binds this Worker to it.
  // FinSight reads its own origin at runtime, so no env change is needed —
  // but the Supabase Auth URL config (Site URL + /auth/callback redirect)
  // must be pointed at finsight.arktosmarketing.com in the Supabase dashboard.
  "routes": [
    { "pattern": "finsight.arktosmarketing.com", "custom_domain": true }
  ]
}
