# FinSight env vars — copy to .env.local for local dev with `npm run dev`.
#
# For production, these are set via wrangler.jsonc "vars" (the two
# NEXT_PUBLIC_* values, which are safe to expose to the browser) and via
# `wrangler secret put` (the SERVICE_ROLE_KEY, which must stay server-side).
#
# Get all three from your Supabase project dashboard:
#   Settings → API → Project URL / Project API keys
#
# .env.local is git-ignored — never commit real keys.

# Public — safe to expose; RLS protects the data.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=REPLACE_WITH_ANON_KEY

# Server-only — bypasses RLS. NEVER commit, NEVER expose to the browser.
# Used for admin operations like firm provisioning, user invites, etc.
# (Not used in Phase 1, but goes here so the env file is complete.)
SUPABASE_SERVICE_ROLE_KEY=REPLACE_WITH_SERVICE_ROLE_KEY

# Server-only — super-admin allowlist (Phase 2a). Comma/semicolon/space
# separated emails. Read at runtime via process.env (NOT NEXT_PUBLIC_*, so it
# never reaches the browser). Fails CLOSED when unset (no super-admins).
# Prod: `wrangler secret put SUPER_ADMIN_EMAILS` — do NOT put it in
# wrangler.jsonc vars (that file is committed). Consumed by
# src/lib/auth/super-admin.ts.
SUPER_ADMIN_EMAILS=you@yourdomain.com
